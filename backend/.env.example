# ---------------------------------------------------------------------
# Cadena de conexión de MongoDB: la misma que usas en MongoDB Compass.
#
# Servidor local (MongoDB Community instalado en tu equipo):
MONGODB_URI=mongodb://localhost:27017
#
# MongoDB Atlas (en la nube): en Atlas, Connect → Drivers → Node.js,
# y reemplaza <db_password> por tu contraseña.
# MONGODB_URI=mongodb+srv://usuario:TU_CLAVE@cluster0.xxxxx.mongodb.net/
# ---------------------------------------------------------------------

# Nombre de la base. Se crea sola la primera vez.
MONGODB_DB=foodloop

PORT=3001

# ---------------------------------------------------------------------
# Revisión histórica, OPCIONAL.
#
# Los registros del centro van de enero a junio de 2026. Con el reloj del
# sistema aparecen todos vencidos y el panel sale vacío, que es correcto
# pero no deja recorrer nada. Declarando una fecha, el sistema se sitúa
# en ese día y puede verse la operación tal como estaba.
#
# No cambia los datos: los registros conservan su fecha. Lo que se mueve
# es el instante desde el que se los mira. La interfaz lo avisa con una
# banda en cada pantalla.
#
# Déjalo comentado para una instalación real.
# REVISION_FECHA=2026-06-23
# ---------------------------------------------------------------------
