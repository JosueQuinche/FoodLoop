node_modules/
dist/
.env
.env.local
*.log
.DS_Store
Thumbs.db

# volcados de comparación del motor (el caso congelado sí se versiona)
volcado*.json
antes.json
despues.json

# los CSV convertidos del centro SÍ se versionan: son la entrada exacta
# con que se produjeron las evidencias, y sin ellos el resultado no se
# puede reproducir. El .xlsx de origen no va al repositorio.

# cuentas creadas al probar el prototipo: llevan hashes de contraseña
# y son de cada quien, no del proyecto
datos/.usuarios.json

# las evidencias se regeneran con `npm run evidencias`; se versiona el
# código que las produce, no su salida, para que no haya dos verdades
evidencias/
evidencias-potencial/

# los documentos de MongoDB SÍ se versionan: son el anexo de datos del
# trabajo y la entrada con que se carga la base sin ejecutar el
# convertidor. Se regeneran con `npm run exportar:mongo`.
entrega/
# las métricas del componente aprendido sí se versionan (sin el conjunto,
# que se regenera con `npm run ml:entrenar`)
!evidencias/
evidencias/*
!evidencias/ml/
evidencias/ml/dataset.csv
